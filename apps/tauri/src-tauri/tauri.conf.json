{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tethra",
  "version": "0.4.1",
  "identifier": "app.tethra.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tethra",
        "width": 1180,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "backgroundColor": "#0D0D0D",
        "decorations": true,
        "transparent": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 20
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "Tethra",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBRjBGRTY4MDU4RDRFRjIKUldUeVRvMEZhUDd3MmdvREZydThBUXhDaVJsTnZrMFFTcm92VGxhK3gxMWJDQ014S3hraHZQdUwK",
      "endpoints": [
        "https://github.com/AnthonyFiset/Tethra/releases/latest/download/latest.json"
      ]
    }
  }
}
